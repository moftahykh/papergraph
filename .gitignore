# ==============================================================================
# PaperGraph Monorepo .gitignore
# Covers Python backend, Flutter client, IDEs, environment secrets, and DBs
# ==============================================================================

# Secrets and Environment Configurations
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets/

# Python Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
ENV/
env/
backend/backend/
backend/backend

# Databases & Cache
*.sqlite3
*.db
postgres_data/
redis_data/
*.rdb

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/android/app/debug/
flutter_app/android/app/profile/
flutter_app/android/app/release/
**/ios/Flutter/.last_build_id
*.apk
*.aab
*.ipa

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
