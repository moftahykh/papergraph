# ==============================================================================
# PaperGraph Environment Configuration Template
# NOTE: Never commit real credentials or API keys to version control.
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Backend General Settings
PROJECT_NAME="PaperGraph Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS='["http://localhost", "http://localhost:3000", "http://localhost:8000"]'

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=papergraph
POSTGRES_PASSWORD=papergraph_dev_pass
POSTGRES_DB=papergraph

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Academic Provider API Keys & Politeness Contacts (Placeholders - Used in Phase 2+)
# Semantic Scholar API Key (Optional, higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key-here

# Crossref Polite Pool Contact Email (Mandatory for responsible API usage)
CROSSREF_MAILTO=your-email@example.com

# OpenAlex Polite Pool Contact Email (Mandatory for high-throughput pool)
OPENALEX_MAILTO=your-email@example.com

# PubMed / NCBI E-Utilities API Key (Optional, increases limit from 3 to 10 req/s)
NCBI_API_KEY=your-ncbi-key-here
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
